{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/majiayu000/awesome-grok-bot/schema/entry.schema.json",
  "title": "Awesome Grok Bot catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "author",
    "summary",
    "import",
    "category",
    "tags",
    "license",
    "verified",
    "updated",
    "shelf"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\[\\]<>]+$"
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\[\\]<>]+$"
        },
        "github": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9._~:/?#@!$&*+,;=%-]+$"
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary_zh": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "job": {
      "type": "string",
      "minLength": 1
    },
    "what_it_does": {
      "type": "string",
      "minLength": 1
    },
    "does_not": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "connectors_optional": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "mcp_custom": {
      "type": "boolean",
      "default": false
    },
    "import": {
      "type": "string",
      "pattern": "^https://x\\.ai/bot/[A-Za-z0-9_-]+$"
    },
    "source": {
      "type": "string"
    },
    "related": {
      "type": "string"
    },
    "demo": {
      "type": "string"
    },
    "first_safe_task": {
      "type": "string",
      "minLength": 1
    },
    "approval_boundary": {
      "type": "string",
      "minLength": 1
    },
    "plugins_needed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional reconnect checklist after Add (first-party plugin names and/or remote MCP labels). Prefer connectors / connectors_optional when structured. Never include credentials."
    },
    "secrets_needed": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "description": "Optional env var NAMES the importer must supply (never values). Example: OPENAI_API_KEY."
    },
    "post_install": {
      "type": "string",
      "minLength": 1,
      "description": "Optional short note of work after Add (reconnect plugins, check skills, run first_safe_task)."
    },
    "acceptance": {
      "type": "string",
      "minLength": 1,
      "description": "Optional proof of done for coding/ops bots (CI green, screenshot before/after, checklist table)."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 4
    },
    "category": {
      "type": "string",
      "enum": [
        "coding-shipping",
        "inbox-calendar",
        "research-briefings",
        "customer-sales",
        "finance-ops",
        "content-publishing",
        "personal-admin",
        "teams-handoffs"
      ]
    },
    "license": {
      "type": "string",
      "default": "CC0-1.0"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "shelf": {
      "type": "string",
      "enum": [
        "featured",
        "solid",
        "studio-door",
        "aka",
        "raw"
      ],
      "description": "Editorial navigation shelf. Reachable \u2260 safe; verified is separate."
    }
  }
}
